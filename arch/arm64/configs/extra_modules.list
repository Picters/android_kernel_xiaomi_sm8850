# Extra-modules packaging whitelist (basenames, no .ko suffix).
# The CI packages ONLY these modules from modules_install into the AnyKernel3
# systemless payload, so stock vendor/GKI modules are never overwritten
# (avoids MODVERSIONS conflicts). Names not produced by the build are ignored;
# the full built-module list is uploaded as an artifact for auditing/refinement.
# One basename per line; blank lines and # comments ignored.

# --- wireless core ---
cfg80211
mac80211

# --- Atheros ---
ath
ath9k_hw
ath9k_common
ath9k_htc
carl9170
ath6kl_core
ath6kl_usb

# --- MediaTek ---
mt7601u

# --- Ralink / rt2x00 ---
rt2x00lib
rt2x00usb
rt2500usb
rt73usb
# rt73usb selects CRC_ITU_T, which ships as its own module; without it
# rt73usb fails to load (unresolved crc_itu_t). Ignored if built-in.
crc-itu-t
rt2800lib
rt2800usb

# --- Realtek (in-tree) ---
rtl8187
# rtl8187 selects EEPROM_93CX6; without eeprom_93cx6.ko packaged, rtl8187
# fails to load (unresolved eeprom_93cx6_read/_multiread). Ignored if built-in.
eeprom_93cx6
rtl_usb
rtlwifi
rtl8192c-common
rtl8192cu
rtl8xxxu

# --- ZyDAS ---
zd1211rw

# --- Bluetooth ---
btusb
btbcm
btrtl
btintel
hci_uart
bcm203x
bpa10x
bfusb
hci_vhci
rfcomm
bnep
hidp

# --- USB Ethernet ---
rtl8150
r8152
cdc_ether
cdc_subset
rndis_host

# --- USB serial ---
usbserial
ch341
cp210x
ftdi_sio
pl2303

# --- CAN / CARsenal ---
can
can-raw
can-bcm
can-gw
can-dev
vcan
slcan
hi311x
mcp251x
ems_usb
esd_usb
gs_usb
kvaser_usb
peak_usb
usb_8dev
netlink_diag

# --- SDR / DVB (videodev/mc intentionally NOT shipped: camera V4L2 framework
#     is already present on-device; shipping ours could clash with the stock
#     camera stack) ---
i2c-mux
dvb-core
dvb_usb_v2
dvb-usb-rtl28xxu
rtl2830
rtl2832
rtl2832_sdr
si2168
zd1301_demod
r820t
e4000
fc0011
fc0012
fc0013

# --- Netfilter / bridged MITM ---
nf_tables
nft_compat
br_netfilter
ebtables
ebtable_broute
ebtable_filter
ebtable_nat

# --- NFS is built =y (builtin), so no .ko is shipped for it ---

# --- Filesystems ---
ntfs3
