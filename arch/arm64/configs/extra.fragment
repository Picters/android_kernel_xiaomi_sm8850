# =============================================================================
# Extra-modules config fragment for Xiaomi 17 (sm8850) GKI 2.0 / android16-6.12
# -----------------------------------------------------------------------------
# Layered ON TOP of gki_defconfig via merge_config.sh; gki_defconfig itself is
# left untouched so the frozen GKI KMI baseline is preserved and rollback is a
# one-line change.
#
# KMI-SAFETY RULES (see memory: sysvipc_rustbinder_bootloop / nh_safe_kmi):
#   * Only add =m leaf drivers, or =y subsystem toggles that do NOT alter a
#     frozen core struct (task_struct / mm_struct / net_device / sk_buff ...).
#   * NEVER enable CONFIG_SYSVIPC here: it grows task_struct -> module_layout
#     shift -> stock vendor modules fail MODVERSIONS -> fleet bootloop.
#   * Wireless-core fields in struct net_device are unconditional in GKI, so
#     CFG80211/MAC80211/WEXT as =m do NOT change net_device -> KMI stays stable.
#   * SuSFS is applied separately by the CI overlay; do NOT touch KSU/SuSFS here.
# The produced .config MUST be gated by a vmlinux.symvers diff vs stock before
# flashing (module_layout must stay 0xe976b219).
# =============================================================================

# --- General / module policy -------------------------------------------------
# Allow unsigned out-of-tree adapter modules to load (KMI symbols only).
# SIG_FORCE stays off, so this only stops build-time auto-signing; no struct change.
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_FORCE_UNLOAD=y

# --- Wireless core (external USB adapters) -----------------------------------
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_MAC80211=m
# CONFIG_MAC80211_MESH removed 2026-07-12 — KMI BREAKER (2nd Mi17 bootloop cause).
# With CONFIG_WLAN=y, enabling MAC80211_MESH flips LL_MAX_HEADER 96->128
# (include/linux/netdevice.h:161), which resizes struct hh_cache.hh_data[]
# (netdevice.h:290). hh_cache is reachable from net_device/neighbour/dst, so
# genksyms shifts ~2500 core net symbol CRCs (__alloc_skb, register_netdevice,
# __dev_queue_xmit, ...) -> stock vendor net modules fail MODVERSIONS -> bootloop.
# module_layout stays 0xe976b219 so the CI check misses it. WLAN=y alone matches
# stock (LL_MAX_HEADER=96); only MESH breaks it. Mesh is not needed for injection.
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=m
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_WLAN_VENDOR_ATMEL=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_USB_ZD1201=m
CONFIG_ZD1211RW=m
CONFIG_USB_NET_RNDIS_WLAN=m

# --- Out-of-tree Realtek injection adapters (aircrack-ng sources) ------------
# Added in a second layer via git submodules + Kconfig wiring (RTL8812AU/8814AU
# chips have no in-tree driver on 6.12). Symbols intentionally NOT set here yet;
# the in-tree rtl8xxxu / rt2x00 / ath9k_htc above already cover the common
# injection adapters and support native mac80211 injection on 6.x.

# --- Bluetooth (BT Arsenal adapters) -----------------------------------------
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIBCM203X=m
CONFIG_BT_HCIBPA10X=m
CONFIG_BT_HCIBFUSB=m
CONFIG_BT_HCIVHCI=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m

# --- USB Ethernet adapters ---------------------------------------------------
CONFIG_USB_RTL8150=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_SUBSET=m
CONFIG_USB_NET_RNDIS_HOST=m

# --- USB serial converters (CAN/serial attacks, Proxmark, CH341/FTDI) --------
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_ACM=m

# --- CAN / CARsenal ----------------------------------------------------------
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_BCM=m
CONFIG_CAN_GW=m
CONFIG_CAN_DEV=m
CONFIG_CAN_VCAN=m
CONFIG_CAN_SLCAN=m
CONFIG_CAN_HI311X=m
CONFIG_CAN_MCP251X=m
CONFIG_CAN_EMS_USB=m
CONFIG_CAN_ESD_USB=m
CONFIG_CAN_GS_USB=m
CONFIG_CAN_KVASER_USB=m
CONFIG_CAN_PEAK_USB=m
CONFIG_CAN_8DEV_USB=m
CONFIG_NETLINK_DIAG=m

# --- SDR (RF Analyzer, rtl-sdr) ----------------------------------------------
# RTL28XXU needs I2C_MUX; RTL2832_SDR needs VIDEO_DEV. With MEDIA_SUBDRV_AUTOSELECT
# off (deliberately) the demods/tuners are NOT auto-pulled, so enable the
# rtl-sdr chain (RTL2832 + R820T/E4000/FC001x tuners) explicitly.
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
# VIDEO_DEV MUST stay =y (matches stock gki_defconfig). The Qualcomm vendor
# camera.ko and rtc6226 FM modules import v4l2 core symbols (v4l2_event_queue,
# __video_register_device, v4l2_subdev_init, v4l2_device_register, ...) and there
# is NO videodev.ko in /vendor_dlkm (0 refs in vendor modules.dep) — stock ships
# V4L2 core built-in. Building it =m produced a videodev.ko that nothing loads at
# boot, so camera.ko failed with "Unknown symbol ... (err -2)" => camera +
# flashlight + FM radio all dead on the Mi17 (confirmed via on-device dmesg
# 2026-07-12). =y still satisfies the =m rtl-sdr/DVB USB modules below (they link
# against the built-in core) and is KMI-safe (only ADDS exports; no struct/CRC
# change, module_layout unaffected).
CONFIG_VIDEO_DEV=y
CONFIG_I2C_MUX=m
CONFIG_DVB_CORE=m
CONFIG_DVB_USB_V2=m
CONFIG_DVB_USB_RTL28XXU=m
CONFIG_DVB_RTL2830=m
CONFIG_DVB_RTL2832=m
CONFIG_DVB_RTL2832_SDR=m
CONFIG_DVB_SI2168=m
CONFIG_DVB_ZD1301_DEMOD=m
CONFIG_MEDIA_TUNER_R820T=m
CONFIG_MEDIA_TUNER_E4000=m
CONFIG_MEDIA_TUNER_FC0012=m
CONFIG_MEDIA_TUNER_FC0013=m
CONFIG_MEDIA_USB_SUPPORT=y

# --- USB gadget ConfigFS functions (HID/BadUSB/USB-Arsenal) ------------------
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
# CONFIG_USB_CONFIGFS_RNDIS is DELIBERATELY off (matches stock; do NOT re-enable).
# It selects USB_F_RNDIS=y, which compiles mainline rndis.o INTO vmlinux and
# exports 14 rndis_* symbols (rndis_add_hdr, rndis_msg_parser, rndis_register,
# rndis_uninit, ...). The Qualcomm vendor usb_f_gsi.ko exports those SAME 14
# names, so it then fails to load with:
#   "usb_f_gsi: exports duplicate symbol rndis_add_hdr (owned by kernel)" (-EEXIST)
# usb_f_gsi is a hard dependency of ipam.ko, the root of the entire cellular+Wi-Fi
# datapath. With ipam absent: rmnet_core/rmnet_* never load (mobile data dead),
# the modem IPA handshake never completes (mss remoteproc watchdog crash-loops
# ~every 67s), and qca_cld3 wifi fails on ipa_wdi_* (internal Wi-Fi HAL dead).
# Verified on-device 2026-07-12: usb_f_gsi's ONLY vmlinux-symbol collisions are
# those 14 rndis_* names — disabling this clears every one and the vendor module
# cleanly owns "rndis". Nothing is lost here: the RNDIS USB gadget function is
# still provided by usb_f_gsi (exactly as stock), and BadUSB/HID is F_HID below.
# CONFIG_USB_CONFIGFS_RNDIS is not set
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y

# --- Netfilter / bridged MITM (ettercap/bettercap/responder/rogue-AP) --------
# REMOVED 2026-07-12 — KMI BREAKER, root cause of the Mi17 bootloop.
# CONFIG_NF_TABLES adds `struct netns_nftables nft` to `struct net`
# (include/net/net_namespace.h:148). genksyms expands struct net through every
# net_device*/sock*/sk_buff pointer, so this shifts the CRC of ~1194 core net
# symbols (__alloc_skb, alloc_netdev_mqs, register_netdevice, netif_rx, ...)
# WITHOUT touching module_layout (stays 0xe976b219 -> CI KMI-CHECK falsely PASS).
# Stock vendor net modules (rmnet_core + deps, qca_cld3) then fail MODVERSIONS
# and the phone bootloops with no vibration. nftables/ebtables-based bridged
# MITM is therefore NOT possible in-tree on this locked-KMI device; if needed it
# must be built out-of-tree against the stock KMI. Wi-Fi injection is unaffected
# (cfg80211/mac80211 are =m and net_device's wifi ptr is unconditional).
# Do NOT re-enable any of these without a full-symvers gate proving zero net-CRC drift:
# CONFIG_NF_TABLES / CONFIG_NF_TABLES_INET / CONFIG_NFT_COMPAT
# CONFIG_BRIDGE_NETFILTER / CONFIG_BRIDGE_NF_EBTABLES
# CONFIG_BRIDGE_EBT_BROUTE / CONFIG_BRIDGE_EBT_T_FILTER / CONFIG_BRIDGE_EBT_T_NAT

# --- NFS (client + server for pivoting / loot) -------------------------------
# Built =y (not =m): on GKI the VFS helper symbols (d_drop, dget_parent, mntget,
# override_creds ...) live in the restricted namespace
# VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver, and NFS-as-module
# fails modpost ("does not import it"). Builtin avoids the namespace check and
# stays KMI-safe (adds only NFS's own symbols to vmlinux; no vendor-consumed
# struct/CRC changes). Cost is a slightly larger Image.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_NFSD=y
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y

# --- Filesystems (loot drives) -----------------------------------------------
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
